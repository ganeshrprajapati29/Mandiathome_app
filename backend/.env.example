NODE_ENV=production
PORT=6055
MONGO_URI=mongodb://127.0.0.1:27017/mandiathome
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES=30d
# OTP / SMS (Fast2SMS DLT route). Fill these on the server only — never commit real keys.
FAST2SMS_API_KEY=
FAST2SMS_SENDER_ID=CITGDN
FAST2SMS_TEMPLATE_ID=199510
OTP_LENGTH=6
OTP_TTL_MINUTES=10
# true = also return the OTP in the API response / show it in the app (testing only).
# When FAST2SMS_API_KEY is empty the OTP is always shown in the app.
OTP_DEV_MODE=false
# Admin account created by seed
ADMIN_EMAIL=admin@mandiathome.com
ADMIN_PASSWORD=Admin@123
# Public base URL (used to build image URLs)
PUBLIC_URL=http://localhost:6055

# Razorpay online payments (Dashboard → Account & Settings → API Keys). Fill on the server only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: secret of the webhook https://<domain>/api/payments/razorpay/webhook (events payment.captured, order.paid)
RAZORPAY_WEBHOOK_SECRET=
